+// TestPanicWithAbortHandler asserts that recovery handles http.ErrAbortHandler
+// as a broken connection: no stack trace and no recovery handler call.
+func TestPanicWithAbortHandler(t *testing.T) {
+	const expectCode = 204
+
+	var buf strings.Builder
+	handled := false
+	router := New()
+	router.Use(CustomRecoveryWithWriter(&buf, func(c *Context, _ any) {
+		handled = true
+		c.AbortWithStatus(http.StatusInternalServerError)
+	}))
+	router.GET("/recovery", func(c *Context) {
+		c.Status(expectCode)
+		panic(http.ErrAbortHandler)
+	})
+	// RUN
+	w := PerformRequest(router, http.MethodGet, "/recovery")
+	// TEST
+	assert.Equal(t, expectCode, w.Code)
+	assert.False(t, handled)
+	assert.Contains(t, buf.String(), http.ErrAbortHandler.Error())
+	assert.NotContains(t, buf.String(), "panic recovered")
+}
