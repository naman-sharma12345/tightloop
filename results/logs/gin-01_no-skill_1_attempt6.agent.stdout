t, expectCode, w.Code)\n\tout := buf.String()\n\tassert.Contains(t, out, http.ErrAbortHandler.Error())\n\tassert.NotContains(t, out, \"panic recovered\")\n}\n\nfunc TestCustomRecoveryWithWriter(t *testing.T) {'''\nopen(p,'w').write(s.replace(old,new,1))\nEOF\ngofmt -l . ; go test -run 'Panic|Recovery' -count=1 . 2>&1 | tail -5 && go vet . && go test -count=1 ./... 2>&1 | tail -8"}},"wire_ingest_context":{"toolu_01Fz7X9JLdYKBwHcKwYbEVTG":{"cwd":"/tmp/tlw-a6wbc9mr"}}}
