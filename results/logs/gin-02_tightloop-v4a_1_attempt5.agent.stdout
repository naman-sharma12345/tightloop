{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KCcwYKEDCacy6bECkRyUgu","type":"tool_result","content":"diff --git a/response_writer.go b/response_writer.go\nindex ab2f5fe..bd2589f 100644\n--- a/response_writer.go\n+++ b/response_writer.go\n@@ -109,7 +109,10 @@ func (w *responseWriter) Written() bool {\n \n // Hijack implements the http.Hijacker interface.\n func (w *responseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {\n-\tif w.Written() {\n+\t// Hijacking is allowed before anything is written or after only the headers\n+\t// are written (e.g. websocket libraries that send a 101 status first), but\n+\t// not once body data has been written.\n+\tif w.size > 0 {\n \t\treturn nil, nil, errHijackAlreadyWritten\n \t}\n \tif w.size < 0 {\ndiff --git a/response_writer_test.go b/response_writer_test.go\nindex ef19841..7bbe814 100644\n--- a/response_writer_test.go\n+++ b/response_writer_test.go\n@@ -154,6 +154,18 @@ func TestResponseWriterHijackAfterWrite(t *testing.T) {\n \t\t\texpectWrittenAfterHijack:  true, // Hijack itself marks the writer as written\n \t\t\texpectError:               nil,\n \t\t},\n+\t\t{\n+\t\t\tname: \"hijack after header write should succeed\",\n+\t\t\taction: func(w ResponseWriter) error {\n+\t\t\t\tw.WriteHeader(http.StatusSwitchingProtocols)\n+\t\t\t\tw.WriteHeaderNow()\n+\t\t\t\treturn nil\n+\t\t\t},\n+\t\t\texpectWrittenBeforeHijack: true,\n+\t\t\texpectHijackSuccess:       true,\n+\t\t\texpectWrittenAfterHijack:  true,\n+\t\t\texpectError:               nil,\n+\t\t},\n \t\t{\n \t\t\tname: \"hijack after write should fail\",\n \t\t\taction: func(w ResponseWriter) error {\nGATE PASS","is_error":false}]},"parent_tool_use_id":null,"session_id":"c243c713-4efd-49bb-9bd0-8fdde9477ec7","uuid":"b226f975-0a3d-49ff-aa68-a0cefcfd1676","timestamp":"2026-10-18T21:27:38.127Z","tool_use_result":{"stdout":"diff --git a/response_writer.go b/response_writer.go\nindex ab2f5fe..bd2589f 100644\n--- a/response_writer.go\n+++ b/r