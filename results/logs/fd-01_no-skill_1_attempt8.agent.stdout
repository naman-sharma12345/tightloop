l_path() {","+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);","+","+    te.assert_output(","+        &[\"--full-path\", \"foo\", \"--and\", \"one/two/c\"],","+        \"one/two/c.foo","+        one/two/C.Foo2\",","+    );","+}","+"," /// --full-path is the user's explicit opt-in to regex-over-full-path matching,"," /// so a path-separation character in the pattern is expected and must not"," /// trigger the diagnostic."]}]}],"moreFiles":0,"changedFiles":["/tmp/tlw-lfbm5sbt/src/main.rs","/tmp/tlw-lfbm5sbt/tests/tests.rs"]}},"tool_result_meta":[{"id":"toolu_01UKBJe29cveV1ojGK1EkfsB","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
