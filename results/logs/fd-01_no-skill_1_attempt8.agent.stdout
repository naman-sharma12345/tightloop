rch pattern\\n/// (either the primary pattern or any '--and' pattern).\\n\")\nopen(p,'w').write(s)\n\nt='tests/tests.rs'\ns=open(t).read()\nanchor=\"/// --full-path is the user's explicit opt-in to regex-over-full-path matching,\"\ntest='''/// '--and' patterns are matched against the file name too, so a '/' in any of\n/// them must produce the same diagnostic as the primary pattern.\n#[test]\nfn test_and_pattern_with_forward_slash_is_rejected() {\n    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);\n\n    te.assert_failure_with_error(\n        &[\"foo\", \"--and\", \"one/two\"],\n        \"[fd error]: The '--and' pattern 'one/two' contains a path-separation character and will not lead to any search results.\",\n    );\n\n    te.assert_failure_with_error(\n        &[\"foo\", \"--and\", \"c\", \"--and\", \"nonexistent/path\"],\n        \"[fd error]: The '--and' pattern 'nonexistent/path' contains a path-separation character and will not lead to any search results.\",\n    );\n}\n\n/// With --full-path, '/' in an '--and' pattern is expected and must not error.\n#[test]\n#[cfg(not(windows))]\nfn test_and_pattern_with_forward_slash_allowed_with_full_path() {\n    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);\n\n    te.assert_output(\n        &[\"--full-path\", \"foo\", \"--and\", \"one/two/c\"],\n        \"one/two/c.foo\n        one/two/C.Foo2\",\n    );\n}\n\n'''\ns=s.replace(anchor,test+anchor,1)\nopen(t,'w').write(s)\nEOF\ncargo fmt && cargo test 2>&1 | grep -E \"test result|FAILED|panicked|error\" | head -20"}}}
