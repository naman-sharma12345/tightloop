s written (size == -1) or after only the","+// headers have been written (size == 0), but not once body data has been written","+// (size > 0). This keeps compatibility with websocket libraries that write the","+// status header before hijacking (e.g. github.com/coder/websocket)."," func (w *responseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {","-\tif w.Written() {","+\tif w.size > 0 {"," \t\treturn nil, nil, errHijackAlreadyWritten"," \t}"," \tif w.size < 0 {"]}]},{"filePath":"/tmp/tlw-cbbl3flc/response_writer_test.go","hunks":[{"oldStart":154,"oldLines":6,"newStart":154,"newLines":17,"lines":[" \t\t\texpectWrittenAfterHijack:  true, // Hijack itself marks the writer as written"," \t\t\texpectError:               nil,"," \t\t},","+\t\t{","+\t\t\tname: \"hijack after header written should succeed\",","+\t\t\taction: func(w ResponseWriter) error {","+\t\t\t\tw.WriteHeaderNow()","+\t\t\t\treturn nil","+\t\t\t},","+\t\t\texpectWrittenBeforeHijack: true,","+\t\t\texpectHijackSuccess:       true,","+\t\t\texpectWrittenAfterHijack:  true,","+\t\t\texpectError:               nil,","+\t\t},"," \t\t{"," \t\t\tname: \"hijack after write should fail\","," \t\t\taction: func(w ResponseWriter) error {"]}]}],"moreFiles":0,"changedFiles":["/tmp/tlw-cbbl3flc/response_writer.go","/tmp/tlw-cbbl3flc/response_writer_test.go"]}},"tool_result_meta":[{"id":"toolu_01HcQNGjYkFVTC1RgtqotyK9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
