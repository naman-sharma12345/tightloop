t match a real\n/// entry — the behaviour this test is pinning (the diagnostic does not\n/// fire) is covered by the fact that the invocation does not error.\n#[test]\n#[cfg(not(windows))]\nfn test_pattern_with_forward_slash_allowed_with_full_path() {\n    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);\n\n    te.assert_output(\n        &[\"--full-path\", \"one/two/c\"],\n        \"one/two/c.foo\n        one/two/C.Foo2\",\n    );\n}\n\n/// Explicit root path\n#[test]\nfn test_explicit_root_path() {\n    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);\n\n    te.assert_output(\n104:fn test_and_basic() {\n131:fn test_and_empty_pattern() {\n137:fn test_and_bad_pattern() {\n147:fn test_and_pattern_starts_with_dash() {\n167:fn test_and_plus_extension() {\n200:fn test_and_plus_type() {\n216:fn test_and_plus_glob() {\n223:fn test_and_plus_fixed_strings() {\n244:fn test_and_plus_ignore_case() {\n255:fn test_and_plus_case_sensitive() {\n265:fn test_and_plus_full_path() {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01BXfqFGXp6Ug3ps8kgyNwE7","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
